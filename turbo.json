{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "env": ["GITHUB_TOKEN"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["codegen"],
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "codegen.ts", "schema/**"],
      "outputs": ["src/gql/**"]
    },
    "lint": {
      "dependsOn": ["codegen"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "codegen"]
    },
    "test": {
      "dependsOn": ["codegen"]
    }
  }
}
